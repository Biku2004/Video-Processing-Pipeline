# ==================================================
# DATABASE CONFIGURATION
# ==================================================
DB_URL=jdbc:h2:mem:mininetflix;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
DB_DIALECT=org.hibernate.dialect.H2Dialect

# For PostgreSQL (production):
# DB_URL=jdbc:postgresql://localhost:5432/mininetflix
# DB_USERNAME=postgres
# DB_PASSWORD=your-postgres-password
# DB_DRIVER=org.postgresql.Driver
# DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ==================================================
# REDIS CONFIGURATION (Rate Limiting)
# ==================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================================================
# JWT CONFIGURATION
# ==================================================
JWT_SECRET=mininetflix-super-secret-key-must-be-at-least-256bits-long-for-hs256
JWT_EXPIRATION=86400000

# ==================================================
# AWS CREDENTIALS
# ==================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here

# ==================================================
# AWS S3 BUCKETS
# ==================================================
# Get these values after running: aws cloudformation describe-stacks --stack-name mininetflix --region ap-south-1
S3_INPUT_BUCKET=mininetflix-input-123456789012
S3_OUTPUT_BUCKET=mininetflix-output-123456789012

# ==================================================
# AWS SQS QUEUES
# ==================================================
# Format: https://sqs.REGION.amazonaws.com/ACCOUNT_ID/QUEUE_NAME
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/mininetflix-jobs.fifo
SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/mininetflix-jobs-dlq.fifo

# ==================================================
# AWS MEDIACONVERT
# ==================================================
# Get MediaConvert endpoint: aws mediaconvert describe-endpoints --region ap-south-1
MEDIACONVERT_ENDPOINT=https://abcdefgh.mediaconvert.ap-south-1.amazonaws.com
MEDIACONVERT_ROLE_ARN=arn:aws:iam::123456789012:role/mininetflix-mediaconvert-role
MEDIACONVERT_OUTPUT_PREFIX=processed/

# ==================================================
# AWS CLOUDFRONT (CDN)
# ==================================================
CLOUDFRONT_DOMAIN=https://d1234567890abc.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

# ==================================================
# CORS CONFIGURATION
# ==================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
