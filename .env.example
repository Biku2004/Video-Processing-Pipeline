# ============================================================
# MiniNetflix — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# JWT
JWT_SECRET=your-super-secret-key-minimum-256-bits-long-replace-this

# Database (PostgreSQL / Supabase)
DB_URL=jdbc:postgresql://db.xxxxx.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_password
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Redis (Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS Credentials (or use IAM role if running on EC2/ECS)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# S3 Buckets (from CloudFormation outputs)
S3_INPUT_BUCKET=mininetflix-input-YOUR_ACCOUNT_ID
S3_OUTPUT_BUCKET=mininetflix-output-YOUR_ACCOUNT_ID

# SQS Queues (from CloudFormation outputs)
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/YOUR_ACCOUNT_ID/mininetflix-jobs.fifo
SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/YOUR_ACCOUNT_ID/mininetflix-jobs-dlq.fifo

# MediaConvert
# Get endpoint from: aws mediaconvert describe-endpoints --region ap-south-1
MEDIACONVERT_ENDPOINT=https://ENDPOINT_ID.mediaconvert.ap-south-1.amazonaws.com
MEDIACONVERT_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/mininetflix-mediaconvert-role

# CloudFront (from CloudFormation outputs)
CLOUDFRONT_DOMAIN=https://DISTRIBUTION_ID.cloudfront.net

# CloudFront Signed URLs (for secure video streaming)
# Generate RSA keys: openssl genrsa -out private_key.pem 2048
# Extract public key: openssl rsa -pubout -in private_key.pem -out public_key.pem
# Then create a Key Group in CloudFront Console
CLOUDFRONT_KEY_PAIR_ID=K1234567890ABC
CLOUDFRONT_PRIVATE_KEY_PATH=./private_key.pem
